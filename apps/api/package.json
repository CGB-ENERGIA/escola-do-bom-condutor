{
  "name": "@ebc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "esbuild src/vercel.ts --bundle --platform=node --format=esm --target=node20 --outfile=api/index.js --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": { "@ebc/shared": "workspace:*", "hono": "^4.6.0", "postgres": "^3.4.0" },
  "devDependencies": { "@types/bun": "latest", "esbuild": "^0.24.0", "typescript": "^5.6.0" }
}
